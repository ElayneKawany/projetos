# Copie este arquivo para terraform.tfvars e preencha os valores reais.
# NUNCA versionar terraform.tfvars com segredos reais.

app_name      = "megag-pmo"
image_name    = "megag-pmo"
image_tag     = "latest"
build_context = ".."
external_port = 3000
log_level     = "info"

