# ============================================================
# MegaG PMO — Variáveis de Ambiente
#
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA comite .env.local no repositório.
# ============================================================


# ------------------------------------------------------------
# AUTENTICAÇÃO — JWT
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo recomendado: 64 caracteres aleatórios
# OBRIGATÓRIO
# ------------------------------------------------------------
JWT_SECRET=troque-por-uma-chave-aleatoria-com-minimo-64-caracteres


# ------------------------------------------------------------
# BANCO DE DADOS — SQLite
# Caminho para o arquivo .db (relativo à raiz do projeto ou absoluto)
# Padrão se omitido: ./data/megag-pmo.db
# OPCIONAL
# ------------------------------------------------------------
DATABASE_URL=./data/megag-pmo.db


# ------------------------------------------------------------
# BANCO DE DADOS — PostgreSQL (migração gradual, ver PLANO_MIGRACAO_POSTGRESQL.md)
# Connection string completa: postgresql://usuario:senha@host:porta/banco
# Exigido pelos repositórios já migrados (sem fallback pro SQLite) — a
# aplicação não sobe sem isso definido a partir da Fase 2 desta migração.
# Em dev local sem Docker/Postgres: node scripts/dev-postgres-teste.js
# (Postgres real via PGlite, connection string de exemplo abaixo já é a dele)
# OBRIGATÓRIO a partir da Fase 2 da migração Postgres
# ------------------------------------------------------------
PG_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/postgres


# ------------------------------------------------------------
# IA — Anthropic Claude
# Obter em: https://console.anthropic.com → API Keys
# Necessário para: geração de ATA, Resumo Executivo IA
# OBRIGATÓRIO para funcionalidades de IA
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-exemplo-substitua-pela-chave-real


# ------------------------------------------------------------
# AMBIENTE
# Valores: development | production | test
# Definido automaticamente pelo Next.js — raramente necessário aqui
# OPCIONAL
# ------------------------------------------------------------
NODE_ENV=development
